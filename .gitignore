# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
# Shipped third-party runtime (Wintun amd64 from wintun.net; see drivers/wintun/README.md)
!drivers/wintun/wintun.dll
# libXray Windows runtime (see docs/BUILD_LIBXRAY_WINDOWS.md)
!engine/third_party/libxray/libXray.dll
engine/third_party/libxray/_extract/
engine/third_party/libxray/*.zip

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
.idea

# Visual Studio solution folder (root repo has no .csproj; VS still creates .vs)
.vs/

# My
/build/
/**/build/
/**/cmake-build-*/
.idea/

# My files for test connect
ovpnfiles

# Local dotnet publish folders (Wine / packaging — may contain secrets next to exe)
publish-win*/

# .NET build artifacts (never commit)
**/bin/
**/obj/
# Local deploy / install scratch (never commit)
_local_deploy*
_local_install/
_local_install_stage/

# Unsupported Win7 client build trees
/build-win7/
/win7/dist/
