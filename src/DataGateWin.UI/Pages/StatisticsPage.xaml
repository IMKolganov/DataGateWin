<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DataGateWin.Pages.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Loaded="OnLoaded">

    <ScrollViewer HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
        <Grid HorizontalAlignment="Stretch">
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="20"  HorizontalAlignment="Stretch">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />

            <Border Padding="{StaticResource CardPadding}" CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel Spacing="12">
                    <StackPanel x:Name="FilterControls" Spacing="16">
                        <TextBlock x:Name="FiltersTitle" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="GroupingLabel" />
                                <ComboBox x:Name="GroupingCombo" MinHeight="36" HorizontalAlignment="Stretch" SelectionChanged="GroupingCombo_OnSelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock x:Name="MetricLabel" />
                                <ComboBox x:Name="MetricCombo" MinHeight="36" HorizontalAlignment="Stretch" SelectionChanged="MetricCombo_OnSelectionChanged" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PresetButtons" Orientation="Horizontal" Spacing="8" Margin="0,0,0,18" />
                        </ScrollViewer>
                        <Expander x:Name="CustomPeriodExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="FromLabel" VerticalAlignment="Center" />
                                    <CalendarDatePicker x:Name="FromPicker" DateChanged="FromPicker_OnDateChanged" />
                                    <TextBlock x:Name="ToLabel" VerticalAlignment="Center" />
                                    <CalendarDatePicker x:Name="ToPicker" DateChanged="ToPicker_OnDateChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ApplyButton" Click="Apply_OnClick" Style="{StaticResource AccentButtonStyle}">
                                        <TextBlock x:Name="ApplyButtonText" />
                                    </Button>
                                    <Button x:Name="ResetButton" Click="Reset_OnClick"><TextBlock x:Name="ResetButtonText" /></Button>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock x:Name="GroupingText" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="PeriodText" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <Grid ColumnSpacing="32" Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="CombinedLabel" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="TotalCombinedText" FontSize="28" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="IncomingLabel" Foreground="#42B8F5" />
                            <TextBlock x:Name="TotalIncomingText" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock x:Name="OutgoingLabel" Foreground="#F4AB4A" />
                            <TextBlock x:Name="TotalUploadedText" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <ProgressRing x:Name="LoadingRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="ChartCard" Padding="24" MinHeight="360" CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel Spacing="16">
                <TextBlock x:Name="ChartTitle" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock x:Name="ChartHint" Style="{StaticResource MutedTextStyle}" />
                <lvc:CartesianChart
                    x:Name="Chart"
                    Height="300"
                    LegendPosition="Top"
                    Background="Transparent"
                    Series="{x:Bind Vm.Series, Mode=OneWay}"
                    XAxes="{x:Bind Vm.XAxes, Mode=OneWay}"
                    YAxes="{x:Bind Vm.YAxes, Mode=OneWay}"
                    TooltipPosition="Top" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
