<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DataGateWin.Pages.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Loaded="OnLoaded">

    <ScrollViewer HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
        <Grid HorizontalAlignment="Stretch">
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="20"  HorizontalAlignment="Stretch">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />

            <Border Padding="{StaticResource CardPadding}" CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="FromLabel" VerticalAlignment="Center" />
                            <CalendarDatePicker x:Name="FromPicker" DateChanged="FromPicker_OnDateChanged" />
                            <TextBlock x:Name="ToLabel" VerticalAlignment="Center" />
                            <CalendarDatePicker x:Name="ToPicker" DateChanged="ToPicker_OnDateChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ApplyButton" Click="Apply_OnClick" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xF295;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                    <TextBlock x:Name="ApplyButtonText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResetButton" Click="Reset_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xF1A0;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                    <TextBlock x:Name="ResetButtonText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="Last7Button" Click="Last7_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="Last7ButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="Last30Button" Click="Last30_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="Last30ButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="Last90Button" Click="Last90_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="Last90ButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock x:Name="GroupingText" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="PeriodText" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="TotalUploadedText" FontSize="16" FontWeight="SemiBold" />
                    <ProgressRing x:Name="LoadingRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="ChartCard" Padding="12" MinHeight="280" CornerRadius="{StaticResource CardCornerRadius}">
                <lvc:CartesianChart
                    x:Name="Chart"
                    Height="260"
                    Background="Transparent"
                    Series="{x:Bind Vm.Series, Mode=OneWay}"
                    XAxes="{x:Bind Vm.XAxes, Mode=OneWay}"
                    YAxes="{x:Bind Vm.YAxes, Mode=OneWay}"
                    TooltipPosition="Top" />
            </Border>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
