<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DataGateWin.Pages.AccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
        <Grid HorizontalAlignment="Stretch">
        <StackPanel Margin="{StaticResource PageMargin}"   Spacing="20" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    MinWidth="110"
                    Click="Refresh_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xF191;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                        <TextBlock x:Name="RefreshButtonText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border
                Padding="16"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="PlanQuotasLabel" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="PlanLineText" TextWrapping="Wrap" Opacity="0.75" />

                    <StackPanel x:Name="TrafficQuotaHeader" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TrafficQuotaLabel" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="QuotaMetaText" TextWrapping="Wrap" Opacity="0.75" />

                    <TextBlock
                        x:Name="QuotaUsedCaptionText"
                        TextWrapping="Wrap"
                        Opacity="0.75" />

                    <ProgressBar
                        x:Name="QuotaBar"
                        Height="16"
                        HorizontalAlignment="Stretch"
                        IsIndeterminate="False"
                        Maximum="100"
                        Minimum="0" />

                    <TextBlock
                        x:Name="QuotaRemainingCaptionText"
                        TextWrapping="Wrap"
                        Opacity="0.75" />
                    <TextBlock x:Name="QuotaDetailsText" TextWrapping="Wrap" Opacity="0.75" />
                    <TextBlock x:Name="ValidityFooterText" TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="LoadStatusRow" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                <ProgressRing x:Name="LoadingRing" Width="24" Height="24" IsActive="False" />
                <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" />
            </StackPanel>

            <Border
                
                Padding="0"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel>
                    <Grid x:Name="ServersHeaderRow" HorizontalAlignment="Left" Padding="8,4,8,4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="120" />
                            <ColumnDefinition Width="0.7*" MinWidth="40" />
                            <ColumnDefinition Width="1*" MinWidth="54" />
                            <ColumnDefinition Width="1*" MinWidth="54" />
                            <ColumnDefinition Width="1.1*" MinWidth="64" />
                            <ColumnDefinition Width="0.9*" MinWidth="50" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="HdrServer"
                            Grid.Column="0"
                            Padding="0,6"
                            MinHeight="0"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="Server"
                            Click="Header_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="ColServer" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    x:Name="SortServer"
                                    FontFamily="{StaticResource IconFont}"
                                    Glyph="&#xF19C;"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="HdrClients"
                            Grid.Column="1"
                            Padding="0,6"
                            MinHeight="0"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="Clients"
                            Click="Header_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="ColClients" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    x:Name="SortClients"
                                    FontFamily="{StaticResource IconFont}"
                                    Glyph="&#xF19C;"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="HdrIn"
                            Grid.Column="2"
                            Padding="0,6"
                            MinHeight="0"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="In"
                            Click="Header_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="ColIn" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    x:Name="SortIn"
                                    FontFamily="{StaticResource IconFont}"
                                    Glyph="&#xF19C;"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="HdrOut"
                            Grid.Column="3"
                            Padding="0,6"
                            MinHeight="0"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="Out"
                            Click="Header_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="ColOut" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    x:Name="SortOut"
                                    FontFamily="{StaticResource IconFont}"
                                    Glyph="&#xF19C;"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="HdrOnline"
                            Grid.Column="4"
                            Padding="0,6"
                            MinHeight="0"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="Online"
                            Click="Header_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="ColOnline" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    x:Name="SortOnline"
                                    FontFamily="{StaticResource IconFont}"
                                    Glyph="&#xF19C;"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="HdrPlan"
                            Grid.Column="5"
                            Padding="0,6"
                            MinHeight="0"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="Plan"
                            Click="Header_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="ColPlan" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    x:Name="SortPlan"
                                    FontFamily="{StaticResource IconFont}"
                                    Glyph="&#xF19C;"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Rectangle Height="1" Opacity="0.15" Fill="Gray" />
                    <ListView x:Name="ServersHost"
                        MaxHeight="440"
                        Padding="0"
                        SelectionMode="Single"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="60" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <TextBlock x:Name="ServerCountText"
                        Margin="16,8"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MutedTextStyle}" />
                    <TextBlock
                        x:Name="EmptyServersText"
                        Margin="24"
                        HorizontalAlignment="Center"
                        Opacity="0.6"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TotalClientsLineText" Opacity="0.75" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
