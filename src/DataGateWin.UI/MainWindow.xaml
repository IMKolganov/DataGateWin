<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DataGateWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DataGate">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Single hamburger lives on NavigationView (WPF parity). -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="DataGate"
            Background="Transparent"
            IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <!-- Loose file via AppIcon.TryAssignBrandMark — never ms-appx (unpackaged MUI FailFast). -->
                <Image
                    x:Name="TitleBarBrandMark"
                    Width="20"
                    Height="20"
                    Margin="10,0,4,0"
                    Stretch="Uniform" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="224"
            CompactPaneLength="64"
            SelectionChanged="NavView_SelectionChanged"
            PaneOpened="NavView_PaneStateChanged"
            PaneClosed="NavView_PaneStateChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF481;" FontFamily="{StaticResource IconFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAccess" Tag="access">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF45B;" FontFamily="{StaticResource IconFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavImport" Tag="import">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF15A;" FontFamily="{StaticResource IconFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavStatistics" Tag="statistics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF340;" FontFamily="{StaticResource IconFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="NavSettings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF6AA;" FontFamily="{StaticResource IconFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel x:Name="PaneFooterRoot" Margin="8,4,8,8" Spacing="6">
                    <Button
                        x:Name="TelegramRowButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12,10"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TelegramChannel_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="#2AABEE" Data="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
                            <TextBlock x:Name="TelegramRowText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ReportRowButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12,10"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ReportIssue_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon Glyph="&#xF28A;" FontFamily="{StaticResource IconFont}" FontSize="18" />
                            <TextBlock x:Name="ReportRowText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid x:Name="UserProfileGrid" Margin="4,4,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="UserAvatarBorder"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            CornerRadius="20">
                            <Grid>
                                <Ellipse Width="40" Height="40">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="UserAvatarBrush" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock
                                    x:Name="UserAvatarInitials"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <StackPanel
                            x:Name="UserIdentityPanel"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                x:Name="UserDisplayName"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="UserEmail"
                                FontSize="12"
                                Opacity="0.7"
                                TextTrimming="CharacterEllipsis"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>

