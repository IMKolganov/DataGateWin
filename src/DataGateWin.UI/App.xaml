<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DataGateWin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- XamlControlsResources added in App() — with a tiny unpackaged app PRI,
         ms-appx:///Microsoft.UI.Xaml/Themes/... fails if declared in App.xaml. -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- Design tokens. No ThemeResource here (unpackaged WinUI FailFast); colors come from UiThemeBrushes. -->
            <!-- Fluent System Icons (MIT), subset. Loose file shipped next to the exe. -->
            <FontFamily x:Key="IconFont">ms-appx:///Assets/Fonts/FluentIcons.ttf#FluentSystemIcons-Regular</FontFamily>
            <x:Double x:Key="ContentMaxWidth">920</x:Double>
            <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
            <Thickness x:Key="CardPadding">20</Thickness>
            <Thickness x:Key="PageMargin">32,24,32,32</Thickness>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="HeroStatusStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
