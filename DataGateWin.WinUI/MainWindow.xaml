<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DataGateWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DataGate">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Single hamburger lives on NavigationView (WPF parity). -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="DataGate"
            IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <Image
                    Width="20"
                    Height="20"
                    Margin="10,0,4,0"
                    Source="ms-appx:///Images/favicon.png"
                    Stretch="Uniform" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="280"
            CompactPaneLength="64"
            SelectionChanged="NavView_SelectionChanged"
            PaneOpened="NavView_PaneStateChanged"
            PaneClosed="NavView_PaneStateChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAccess" Tag="access">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavImport" Tag="import">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavStatistics" Tag="statistics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel x:Name="PaneFooterRoot" Margin="8,0,8,8" Spacing="6">
                    <!-- Expanded: full-width text buttons -->
                    <Button
                        x:Name="TelegramChannelButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="TelegramChannel_OnClick" />
                    <Button
                        x:Name="ReportIssueButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="ReportIssue_OnClick" />

                    <!-- Compact: icon-only (visible when pane collapsed) -->
                    <Button
                        x:Name="TelegramChannelCompactButton"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        Padding="0"
                        Visibility="Collapsed"
                        Click="TelegramChannel_OnClick"
                        ToolTipService.ToolTip="Telegram">
                        <FontIcon Glyph="&#xE715;" FontSize="16" />
                    </Button>
                    <Button
                        x:Name="ReportIssueCompactButton"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        Padding="0"
                        Visibility="Collapsed"
                        Click="ReportIssue_OnClick"
                        ToolTipService.ToolTip="Report">
                        <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                    </Button>

                    <Grid x:Name="UserProfileGrid" Margin="4,4,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="UserAvatarBorder"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="20">
                            <Grid>
                                <Ellipse Width="40" Height="40">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="UserAvatarBrush" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock
                                    x:Name="UserAvatarInitials"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <TextBlock
                            x:Name="UserDisplayName"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
