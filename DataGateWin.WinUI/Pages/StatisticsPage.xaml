<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DataGateWin.Pages.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Loaded="OnLoaded">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE9D9;" FontSize="18" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="FromLabel" VerticalAlignment="Center" />
                            <CalendarDatePicker x:Name="FromPicker" DateChanged="FromPicker_OnDateChanged" />
                            <TextBlock x:Name="ToLabel" VerticalAlignment="Center" />
                            <CalendarDatePicker x:Name="ToPicker" DateChanged="ToPicker_OnDateChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ApplyButton" Click="Apply_OnClick" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                    <TextBlock x:Name="ApplyButtonText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResetButton" Click="Reset_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8F2;" FontSize="14" />
                                    <TextBlock x:Name="ResetButtonText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="Last7Button" Click="Last7_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE787;" FontSize="14" />
                                <TextBlock x:Name="Last7ButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="Last30Button" Click="Last30_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE787;" FontSize="14" />
                                <TextBlock x:Name="Last30ButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="Last90Button" Click="Last90_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE787;" FontSize="14" />
                                <TextBlock x:Name="Last90ButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="GroupingText" Opacity="0.85" />
                    <TextBlock x:Name="PeriodText" Opacity="0.85" />
                    <TextBlock x:Name="TotalUploadedText" FontWeight="SemiBold" />
                    <ProgressRing x:Name="LoadingRing" Width="28" Height="28" IsActive="False" />
                    <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="8" MinHeight="280" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <lvc:CartesianChart
                    x:Name="Chart"
                    Height="260"
                    Series="{x:Bind Vm.Series, Mode=OneWay}"
                    XAxes="{x:Bind Vm.XAxes, Mode=OneWay}"
                    YAxes="{x:Bind Vm.YAxes, Mode=OneWay}"
                    TooltipPosition="Top" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
