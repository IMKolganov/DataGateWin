<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DataGateWin.Pages.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Loaded="HomePage_OnLoaded"
    Unloaded="HomePage_OnUnloaded">

    <Grid Margin="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE80F;" FontSize="18" VerticalAlignment="Center" />
            <TextBlock
                x:Name="WelcomeTitle"
                FontSize="20"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE701;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionStatusLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Top">
                        <Button
                            x:Name="ConnectButton"
                            MinWidth="132"
                            Click="ConnectButton_OnClick"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE704;" FontSize="14" />
                                <TextBlock x:Name="ConnectButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="DisconnectButton"
                            MinWidth="132"
                            Click="DisconnectButton_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8CD;" FontSize="14" />
                                <TextBlock x:Name="DisconnectButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VpnServerLabel" VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="ServerModeCombo"
                        Grid.Column="1"
                        SelectionChanged="ServerModeCombo_OnSelectionChanged" />
                </Grid>

                <Grid
                    x:Name="ManualServerRow"
                    ColumnSpacing="8"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ServerLabel" VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="ManualServerCombo"
                        Grid.Column="1"
                        SelectionChanged="ManualServerCombo_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image
                                        Width="22"
                                        Height="16"
                                        Source="{Binding FlagImage}"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding FlagVisibility}" />
                                    <TextBlock
                                        Text="{Binding Label}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        x:Name="RefreshServersButton"
                        Grid.Column="2"
                        Click="RefreshServersButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock x:Name="RefreshServersButtonText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel x:Name="NetworkInfoPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="NetworkServerText" TextWrapping="Wrap" />
                    <TextBlock x:Name="NetworkVpnIpText" FontFamily="Consolas" />
                    <TextBlock x:Name="NetworkExternalIpText" FontFamily="Consolas" />
                    <TextBlock x:Name="NetworkDnsText" FontFamily="Consolas" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            x:Name="TrafficLogsCard"
            Grid.Row="2"
            Padding="16"
            VerticalAlignment="Stretch"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="TrafficTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="#3DC05C" />
                        <TextBlock
                            x:Name="TrafficInText"
                            Foreground="#3DC05C"
                            Text="{x:Bind Traffic.InRateText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE898;" FontSize="12" Foreground="#E05454" />
                        <TextBlock
                            x:Name="TrafficOutText"
                            Foreground="#E05454"
                            Text="{x:Bind Traffic.OutRateText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    x:Name="TrafficErrorText"
                    Grid.Row="1"
                    Foreground="OrangeRed"
                    TextWrapping="Wrap"
                    Text="{x:Bind Traffic.ErrorText, Mode=OneWay}" />

                <lvc:CartesianChart
                    x:Name="TrafficChart"
                    Grid.Row="2"
                    Height="150"
                    LegendPosition="Hidden"
                    Series="{x:Bind Traffic.Series, Mode=OneWay}"
                    TooltipPosition="Top"
                    XAxes="{x:Bind Traffic.XAxes, Mode=OneWay}"
                    YAxes="{x:Bind Traffic.YAxes, Mode=OneWay}" />

                <CheckBox
                    x:Name="ShowEngineLogsCheck"
                    Grid.Row="3"
                    Click="ShowEngineLogsCheck_OnClick" />

                <TextBox
                    x:Name="LogTextBox"
                    Grid.Row="4"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="12"
                    IsReadOnly="True"
                    TextWrapping="NoWrap"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
