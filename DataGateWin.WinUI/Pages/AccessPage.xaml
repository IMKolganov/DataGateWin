<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DataGateWin.Pages.AccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="AccessPage_OnLoaded">

    <ScrollViewer
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MinWidth="720" Spacing="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE774;" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="20"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                </StackPanel>
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    MinWidth="110"
                    Click="Refresh_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock x:Name="RefreshButtonText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8EC;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlanQuotasLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PlanLineText" TextWrapping="Wrap" Opacity="0.85" />

                    <StackPanel x:Name="TrafficQuotaHeader" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="TrafficQuotaLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="QuotaMetaText" TextWrapping="Wrap" Opacity="0.85" />

                    <TextBlock
                        x:Name="QuotaUsedCaptionText"
                        TextWrapping="Wrap"
                        Opacity="0.85" />

                    <ProgressBar
                        x:Name="QuotaBar"
                        Height="16"
                        HorizontalAlignment="Stretch"
                        IsIndeterminate="False"
                        Maximum="100"
                        Minimum="0" />

                    <TextBlock
                        x:Name="QuotaRemainingCaptionText"
                        TextWrapping="Wrap"
                        Opacity="0.85" />
                    <TextBlock x:Name="QuotaDetailsText" TextWrapping="Wrap" Opacity="0.85" />
                    <TextBlock x:Name="ValidityFooterText" TextWrapping="Wrap" Opacity="0.85" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="LoadingRing" Width="24" Height="24" IsActive="False" />
                <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Padding="12,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColServer" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE716;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColClients" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColIn" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE898;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColOut" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE701;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColOnline" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8EC;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="ColPlan" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="ServersHost" />
                    <TextBlock
                        x:Name="EmptyServersText"
                        Margin="16"
                        HorizontalAlignment="Center"
                        Opacity="0.6"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TotalClientsLineText" Opacity="0.75" />
        </StackPanel>
    </ScrollViewer>
</Page>
