<Window
    x:Class="DataGateWin.Views.FirstRunConfigurationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configuration">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer Padding="28">
        <StackPanel MaxWidth="640" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE713;" FontSize="20" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleText"
                    FontSize="22"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="SubtitleText" Opacity="0.75" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE774;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="ApiLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox x:Name="ApiBaseUrlBox" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE192;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="ClientIdLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox x:Name="GoogleClientIdBox" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE968;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="PortLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox x:Name="RedirectPortBox" MaxLength="5" />

            <TextBlock
                x:Name="StatusText"
                Foreground="Red"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Button
                x:Name="SaveButton"
                Height="46"
                HorizontalAlignment="Stretch"
                Click="Save_OnClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock x:Name="SaveButtonText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                x:Name="CancelButton"
                Height="42"
                HorizontalAlignment="Stretch"
                Click="Cancel_OnClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                    <TextBlock x:Name="CancelButtonText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Window>
