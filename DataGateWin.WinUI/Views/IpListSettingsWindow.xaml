<Window
    x:Class="DataGateWin.Views.IpListSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IP lists">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer
        x:Name="RootScroll"
        Padding="20,12,20,20"
        VerticalScrollBarVisibility="Auto"
        Loaded="RootScroll_OnLoaded">
        <StackPanel Spacing="4" MaxWidth="640">
            <TextBlock
                x:Name="WindowsNoticeText"
                Opacity="0.85"
                TextWrapping="Wrap"
                Margin="0,0,0,14" />

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE968;" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock x:Name="EnableTitleText" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                x:Name="EnableSubtitleText"
                                Opacity="0.75"
                                TextWrapping="Wrap"
                                Margin="0,4,0,0" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="CidrEnabledToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Toggled="CidrEnabledToggle_OnToggled" />
                    </Grid>

                    <TextBlock
                        x:Name="DisabledNotice"
                        Opacity="0.75"
                        TextWrapping="Wrap"
                        Margin="0,0,0,10"
                        Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,4">
                        <FontIcon Glyph="&#xE774;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="SourceTitleText"
                            FontSize="16"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        x:Name="SourceSubtitleText"
                        Opacity="0.75"
                        TextWrapping="Wrap"
                        Margin="0,0,0,8" />
                    <TextBox
                        x:Name="UrlsTextBox"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="100"
                        MaxHeight="220"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,6">
                        <FontIcon Glyph="&#xE823;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="FrequencyLabelText" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox
                        x:Name="FrequencyCombo"
                        MinWidth="200"
                        HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,6">
                        <FontIcon Glyph="&#xE707;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="CoverageLabelText" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        x:Name="CoverageWinNoteText"
                        Opacity="0.75"
                        TextWrapping="Wrap"
                        Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="CoverageFastRadio" GroupName="Cov" />
                        <RadioButton x:Name="CoverageFullRadio" GroupName="Cov" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,6">
                        <FontIcon Glyph="&#xE81E;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="RouteLimitLabelText" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        x:Name="RouteLimitHintText"
                        Opacity="0.75"
                        TextWrapping="Wrap"
                        Margin="0,0,0,6" />
                    <TextBox
                        x:Name="RouteLimitTextBox"
                        Width="120"
                        HorizontalAlignment="Left"
                        MaxLength="4" />

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
                        <Button
                            x:Name="SaveButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SaveButton_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock x:Name="SaveButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="UpdateNowButton" Click="UpdateNowButton_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock x:Name="UpdateNowButtonText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="SaveMessageText"
                        Opacity="0.85"
                        Margin="0,10,0,0"
                        Visibility="Collapsed"
                        TextWrapping="Wrap" />

                    <Border
                        Height="1"
                        Margin="0,18,0,14"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <FontIcon Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="StatusTitleText"
                            FontSize="16"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="LastUpdatedText" TextWrapping="Wrap" />
                    <TextBlock x:Name="LoadedRoutesText" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock x:Name="LastErrorText" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
