<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DataGateWin</RootNamespace>
    <AssemblyName>DataGateWin</AssemblyName>
    <Product>DataGate</Product>
    <AssemblyTitle>DataGate</AssemblyTitle>
    <Description>DataGate</Description>
    <AssemblyVersion>1.0.13</AssemblyVersion>
    <FileVersion>1.0.13</FileVersion>
    <ApplicationManifest Condition="'$(Configuration)'=='Debug'">app.manifest.debug.xml</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)'!='Debug'">app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-x64.pubxml')">win-x64.pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\LockScreenLogo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square150x150Logo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square44x44Logo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\StoreLogo.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\AppIcon.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\favicon.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Images\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\IpLists\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <None Include="Localization\Strings.*.xaml"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\drivers\wintun\wintun.dll" Link="engine\wintun.dll"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <!-- Runtime XDocument load — must not enter PRI (Strings.es-mx.xaml → PRI249). -->
    <Page Remove="Localization\**\*" />
    <ApplicationDefinition Remove="Localization\**\*" />
    <PRIResource Remove="Localization\**\*" />
    <!-- Keep assets as loose files only — Content inclusion pulled them into SDK PRI layout
         and broke unpackaged XamlControlsResources theme lookup in smoke bisect. -->
    <Content Remove="Assets\**\*" />
    <Content Remove="Images\**\*" />
    <None Include="Assets\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="Images\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <None Update="appsettings.example.json"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.0-rc6.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataGateWin.Core\DataGateWin.Core.csproj" />
    <ProjectReference Include="..\DataGateWin.CrashReporting\DataGateWin.CrashReporting.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>

  <!-- Unpackaged WinUI: publish often drops or replaces the SDK app PRI. Stage the
       SDK-built DataGateWin.pri (EmbeddedData XBF + merged Controls/LiveCharts themes)
       and loose *.xbf for diagnostics. Do NOT rebuild a Path-only PRI — that drops themes. -->
  <Target Name="RebuildUnpackagedAppPri" AfterTargets="Publish">
    <PropertyGroup>
      <_MakePri>$(NuGetPackageRoot)microsoft.windows.sdk.buildtools\10.0.28000.2705\bin\10.0.28000.0\x64\makepri.exe</_MakePri>
      <_RebuildPriScript>$(MSBuildProjectDirectory)\tools\Rebuild-UnpackagedPri.ps1</_RebuildPriScript>
      <_PublishDirTrimmed>$([System.String]::Copy('$(PublishDir)').TrimEnd('\').TrimEnd('/'))</_PublishDirTrimmed>
      <_IntermediateTrimmed>$([System.String]::Copy('$(IntermediateOutputPath)').TrimEnd('\').TrimEnd('/'))</_IntermediateTrimmed>
      <_OutputPriCandidate>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutputPath)$(AssemblyName).pri'))</_OutputPriCandidate>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_RebuildPriScript)&quot; -PublishDir &quot;$(_PublishDirTrimmed)&quot; -IntermediateDir &quot;$(_IntermediateTrimmed)&quot; -AssemblyName &quot;$(AssemblyName)&quot; -MakePri &quot;$(_MakePri)&quot; -OutputPri &quot;$(_OutputPriCandidate)&quot;"
          Condition="Exists('$(_RebuildPriScript)') And '$(_PublishDirTrimmed)' != ''" />
    <Warning Text="Skipped Rebuild-UnpackagedPri (script/PublishDir missing)."
             Condition="!Exists('$(_RebuildPriScript)') Or '$(_PublishDirTrimmed)' == ''" />
  </Target>
</Project>
